# Copy to .env and fill in. .env is gitignored.

# Operational database (customers/orders/returns) — PostgreSQL, required.
# Tests never read this: they always pass an explicit SQLite path and need no server.
# Local dev, e.g. a dedicated container:
#   docker run -d --name retail_support_agent-postgres \
#     -e POSTGRES_USER=rsa_app -e POSTGRES_PASSWORD=<password> \
#     -e POSTGRES_DB=retail_support_agent -p 5434:5432 \
#     -v retail_support_agent_pgdata:/var/lib/postgresql/data postgres:16-alpine
#   uv run rsa ingest   # creates the schema and loads customers/orders/returns
RSA_DATABASE_URL=postgresql+psycopg://rsa_app:<password>@localhost:5434/retail_support_agent

# Which LLM backend the agent uses: "nvidia" or "anthropic"
LLM_PROVIDER=nvidia

# NVIDIA NIM (OpenAI-compatible endpoint) — required when LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
# JUDGE_MODELS=nvidia/nemotron-3-ultra-550b-a55b

# Anthropic — required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Langfuse observability (https://cloud.langfuse.com → Settings → API Keys)
# Both keys are required for Langfuse to initialise; tracing is silently skipped
# when either is missing so the agent still works without an account.
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGFUSE_HOST=https://cloud.langfuse.com   # only needed for self-hosted instances

# Caching (all optional; defaults shown)
# RSA_PROMPT_CACHE=1                     # context/prefix caching (Anthropic breakpoints; cached-token accounting)
# RSA_RETRIEVAL_CACHE_SIZE=256           # exact LRU over retrieval results; 0 = off
# RSA_SEMANTIC_CACHE=1                   # semantic cache for policy-only answers; 0 = off
# RSA_SEMANTIC_CACHE_THRESHOLD=0.93      # cosine similarity (BGE-small) required for a hit
# RSA_SEMANTIC_CACHE_TTL_S=604800        # entry lifetime (7 days)
# RSA_SEMANTIC_CACHE_DF=0.10             # corpus words in <=10% of chunks must match exactly
# RSA_SEMANTIC_CACHE_PATH=data/cache/semantic_cache.db
# RSA_MAX_RERANK_CANDIDATES=10           # chunks the cross-encoder scores per search
# RSA_MODEL_THREADS=                     # ONNX threads per model; unset = all cores. With
#                                        # several worker processes per host, set ~cores/workers

# Conversation memory (rsa chat / Streamlit chat)
# RSA_SESSION_SUMMARY_EVERY=10           # summarise into summary.md every N turns
# RSA_SESSION_KEEP_RECENT=2              # summarised turns still sent verbatim
# RSA_SESSION_MAX_HISTORY_CHARS=16000

# Judge method: geval (steps + chain of thought + probability-weighted score) | verdict
# RSA_JUDGE_METHOD=geval

# Model downloads. The first run downloads the embedding, reranker and classifier
# models into .cache/. After that, set this to stop every model load from checking
# the Hugging Face Hub online (faster startup, works without network). Leave it
# unset on a fresh machine or when changing a model, or the download will fail.
# HF_HUB_OFFLINE=1
